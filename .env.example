# OpenAI-compatible LLM endpoint used by the extraction/verification stages.
LLM_BASE_URL=https://compute.virtuals.io/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=moonshotai-kimi-k3

# Optional: macOS keychain lookup fallback when LLM_API_KEY is unset.
# LLM_API_KEY_CMD=security find-generic-password -a cabhishek -s pi-virtuals-compute -w

# Exa CLI is invoked as a subprocess; override the binary name if needed.
# EXA_BIN=exa
